+if ((${#netrc_paths[@]})) && rg -l -i '(^|[[:space:]])password[[:space:]]+[^[:space:]]+' "${netrc_paths[@]}"; then
+  echo 'unsafe implementation text found' >&2
+  exit 1
+fi
