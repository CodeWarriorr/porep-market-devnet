+    rg -l -i '\b(private[_-]?key)\s*=' "${scan_paths[@]}" ||
+    rg -l -i '(^|[[:space:]/:])_?auth(token)?[[:space:]]*=' "${scan_paths[@]}" ||
+    rg -l 'while[[:space:]]+true([[:space:]]|;|$)' "${scan_paths[@]}"; then
+    echo 'unsafe implementation text found' >&2
+    exit 1
+  fi
+fi
