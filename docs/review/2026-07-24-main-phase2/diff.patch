+    ports: ["127.0.0.1:22300:12300", "127.0.0.1:22310:12310", "127.0.0.1:24701:4701"]
+    environment: [CURIO_REPO_PATH=/var/lib/curio, CURIO_HARMONYDB_HOSTS=yugabyte, CONTRACT_ENV_FILE=/var/lib/contracts/curio-devnet.env]
+    volumes: ["${DEVNET_DATA_DIR}/curio:/var/lib/curio:rw", "${DEVNET_DATA_DIR}/lotus:/var/lib/lotus:ro", "${DEVNET_DATA_DIR}/lotus-miner:/var/lib/lotus-miner:ro", "${DEVNET_DATA_DIR}/contracts:/var/lib/contracts:rw", "${DEVNET_PROOF_PARAMETERS_DIR}:/var/tmp/filecoin-proof-parameters:rw"]
+  yugabyte:
+    image: ${DEVNET_YUGABYTE_IMAGE}
