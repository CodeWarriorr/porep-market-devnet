+    volumes: ["${DEVNET_DATA_DIR}/lotus-miner:/var/lib/lotus-miner:rw", "${DEVNET_DATA_DIR}/lotus:/var/lib/lotus:ro", "${DEVNET_DATA_DIR}/genesis:/var/lib/genesis:ro", "${DEVNET_PROOF_PARAMETERS_DIR}:/var/tmp/filecoin-proof-parameters:rw"]
+  curio:
+    image: ${DEVNET_IMAGE_NAMESPACE}/curio:${DEVNET_CURIO_SHORT_COMMIT}
