+    environment: [CURIO_MK12_CLIENT_REPO=/var/lib/curio-client]
+    volumes: ["${DEVNET_DATA_DIR}/piece-server:/var/lib/curio-client:rw", "${DEVNET_DATA_DIR}/piece-server/.synapse-sdk.ready:/var/lib/curio-client/.synapse-sdk.ready:ro", "${DEVNET_DATA_DIR}/curio:/var/lib/curio:ro", "${DEVNET_DATA_DIR}/lotus:/var/lib/lotus:ro", "${DEVNET_DATA_DIR}/lotus-miner:/var/lib/lotus-miner:ro", "${DEVNET_DATA_DIR}/contracts:/var/lib/contracts:rw", "${DEVNET_PROOF_PARAMETERS_DIR}:/var/tmp/filecoin-proof-parameters:rw"]
+  indexer:
+    image: ${DEVNET_IMAGE_NAMESPACE}/indexer:${DEVNET_CURIO_SHORT_COMMIT}
