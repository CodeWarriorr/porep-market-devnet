+    volumes: ["${DEVNET_DATA_DIR}/indexer:/var/lib/indexer:rw", "${DEVNET_DATA_DIR}/curio:/var/lib/curio:ro", "${DEVNET_DATA_DIR}/lotus:/var/lib/lotus:ro", "${DEVNET_DATA_DIR}/lotus-miner:/var/lib/lotus-miner:ro", "${DEVNET_PROOF_PARAMETERS_DIR}:/var/tmp/filecoin-proof-parameters:rw"]
