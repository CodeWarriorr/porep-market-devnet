+      retries: 60
+      start_period: 30s
+    ports: ["127.0.0.1:25433:5433", "127.0.0.1:29042:9042", "127.0.0.1:25434:15433"]
+    command: [bin/yugabyted, start, --base_dir=/home/yugabyte/yb_data, --background=false, --advertise_address=yugabyte]
+    volumes: ["${DEVNET_DATA_DIR}/yugabyte:/home/yugabyte/yb_data:rw", "${DEVNET_DATA_DIR}/yugabyte-disk0:/mnt/disk0:rw", "${DEVNET_DATA_DIR}/yugabyte-disk1:/mnt/disk1:rw"]
+  piece-server:
+    image: ${DEVNET_IMAGE_NAMESPACE}/piece-server:${DEVNET_CURIO_SHORT_COMMIT}
