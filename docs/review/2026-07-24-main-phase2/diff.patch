+services:
+  lotus:
+    image: ${DEVNET_IMAGE_NAMESPACE}/lotus:${DEVNET_CURIO_SHORT_COMMIT}
+    init: true
+    restart: on-failure:5
+    logging: {driver: json-file, options: {max-size: 20m, max-file: "3"}}
+    healthcheck:
+      test: [CMD, lotus, net, id]
+      interval: 10s
+      timeout: 5s
+      retries: 60
+      start_period: 30s
+    ports: ["127.0.0.1:2234:1234"]
+    environment: [LOTUS_FEVM_ENABLEETHRPC=true, LOTUS_API_LISTENADDRESS=/dns/lotus/tcp/1234/http, LOTUS_CHAININDEXER_ENABLEINDEXER=true, LOTUS_NETWORK_VERSION=27, LOTUS_FIREHORSE_UPGRADE_EPOCH=200]
+    volumes: ["${DEVNET_DATA_DIR}/lotus:/var/lib/lotus:rw", "${DEVNET_DATA_DIR}/genesis:/var/lib/genesis:rw", "${DEVNET_PROOF_PARAMETERS_DIR}:/var/tmp/filecoin-proof-parameters:rw"]
+  contracts-bootstrap:
+    image: ${DEVNET_IMAGE_NAMESPACE}/contracts-bootstrap:${DEVNET_CURIO_SHORT_COMMIT}
+    init: true
+    restart: "no"
+    logging: {driver: json-file, options: {max-size: 20m, max-file: "3"}}
+    depends_on: [lotus]
+    environment: [CONTRACT_SOURCE_MODE=local, FILECOIN_SERVICES_LOCAL_PATH=/opt/local-src/filecoin-services, MULTICALL3_LOCAL_PATH=/opt/local-src/multicall3, LOTUS_RPC_URL=http://lotus:1234/rpc/v1, CHAIN_ID=31415926]
+    volumes: ["${DEVNET_DATA_DIR}/contracts:/var/lib/contracts:rw", "${DEVNET_DATA_DIR}/lotus:/var/lib/lotus:ro", "${DEVNET_DATA_DIR}/genesis:/var/lib/genesis:ro", "${DEVNET_FILECOIN_SERVICES_SOURCE}:/opt/local-src/filecoin-services:ro", "${DEVNET_MULTICALL3_SOURCE}:/opt/local-src/multicall3:ro"]
+  lotus-miner:
